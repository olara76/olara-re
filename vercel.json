{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/politica-privacidad", "destination": "/privacidad", "permanent": true },
    { "source": "/politica-cookies", "destination": "/cookies", "permanent": true },
    { "source": "/legal/aviso-legal(.html)?", "destination": "/aviso-legal", "permanent": true },
    { "source": "/legal/politica-privacidad(.html)?", "destination": "/privacidad", "permanent": true },
    { "source": "/legal/politica-cookies(.html)?", "destination": "/cookies", "permanent": true },
    { "source": "/hero.jpg", "destination": "/img/hero.jpg", "permanent": true },
    { "source": "/salon.jpg", "destination": "/img/salon.jpg", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
