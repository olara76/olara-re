{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/vivienda.js": { "includeFiles": "textos/**" }
  },
  "rewrites": [
    { "source": "/viviendas", "destination": "/api/listado?lang=es" },
    { "source": "/viviendas/:id", "destination": "/api/vivienda?id=:id&lang=es" },
    { "source": "/:lang(en|de|fr|it|ru|zh)/viviendas", "destination": "/api/listado?lang=:lang" },
    { "source": "/:lang(en|de|fr|it|ru|zh)/viviendas/:id", "destination": "/api/vivienda?id=:id&lang=:lang" },
    { "source": "/sitemap-viviendas.xml", "destination": "/api/sitemap-viviendas" }
  ],
  "redirects": [
    { "source": "/politica-privacidad", "destination": "/privacidad", "permanent": true },
    { "source": "/politica-cookies", "destination": "/cookies", "permanent": true },
    { "source": "/legal/aviso-legal(.html)?", "destination": "/aviso-legal", "permanent": true },
    { "source": "/legal/politica-privacidad(.html)?", "destination": "/privacidad", "permanent": true },
    { "source": "/legal/politica-cookies(.html)?", "destination": "/cookies", "permanent": true },
    { "source": "/hero.jpg", "destination": "/img/hero.jpg", "permanent": true },
    { "source": "/salon.jpg", "destination": "/img/salon.jpg", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/seleccion/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
